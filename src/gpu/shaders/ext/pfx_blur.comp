#version 450
// Post-processing, step 2: a separable 9-tap Gaussian over the bloom (one
// direction per dispatch, taps `step` pixels apart).

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D src;
layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D dst;
layout(std140, set = 2, binding = 0) uniform Params {
    ivec4 size; // w, h, direction x, direction y (times the step)
} P;

void main() {
    ivec2 o = ivec2(gl_GlobalInvocationID.xy);
    if (o.x >= P.size.x || o.y >= P.size.y) return;
    const float w[5] = float[](0.2270270, 0.1945946, 0.1216216, 0.0540541, 0.0162162);
    ivec2 d = P.size.zw;
    vec3 acc = imageLoad(src, o).rgb * w[0];
    for (int i = 1; i < 5; ++i) {
        acc += imageLoad(src, clamp(o + d * i, ivec2(0), P.size.xy - 1)).rgb * w[i];
        acc += imageLoad(src, clamp(o - d * i, ivec2(0), P.size.xy - 1)).rgb * w[i];
    }
    imageStore(dst, o, vec4(acc, 1.0));
}
