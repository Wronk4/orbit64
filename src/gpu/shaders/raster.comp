#version 450
#extension GL_GOOGLE_include_directive : require
// The RDP's pixel pipeline at S times the frame buffer resolution: one
// invocation per output pixel runs every primitive of its tile's list in
// drawing order, with the pixel's colour and depth kept in registers. It is
// the pipeline of src/raster.hpp and HiResSink (src/hires.cpp), line for line,
// so the GPU draws what the CPU high-resolution renderer draws.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#define NUM_UNIFORM 1
#define NUM_RO_BUF 2
#define NUM_RW_TEX 0
#include "common.glsl"
#include "layout.h"

layout(std430, RO_BUFFER(0)) readonly buffer FrameData { uint D[]; };
layout(std430, RO_BUFFER(1)) readonly buffer Texels { uint T[]; }; // decode.comp's tables
layout(std430, RW_BUFFER(0)) buffer ColorBuffer { uint color_buf[]; };
layout(std430, RW_BUFFER(1)) buffer DepthBuffer { float depth_buf[]; };

layout(std140, UNIFORM(0)) uniform Pass {
    uint scale;      // S
    uint width;      // frame buffer width * S: row stride of both buffers
    uint height;     // 240 * S
    uint tiles_x;    // bins per row
    uint tile_table; // word offset of the (first, count) pairs
    uint work_list;  // word offset of the tiles with primitives
    uint prims;      // word offset of primitive 0
    uint has_depth;
    float inv_scale; // 1 / S
} P;

float fword(uint i) { return uintBitsToFloat(D[i]); }

#include "tmem.glsl"

int floor_to_int(float v) {
    int i = int(v);
    return v < float(i) ? i - 1 : i;
}

// ---- Texture unit (raster::sample_texture) -------------------------------------

// raster::tex_coord(): texels -> s10.5, shifted, clamped, relative to the tile.
int tex_coord(float c, uint shift, bool clmp, uint lo, uint hi) {
    float v = c * 32.0;
    int x = !(v > -32768.0) ? -0x8000 : v >= 32767.0 ? 0x7FFF : floor_to_int(v);
    if (shift < 11u) x >>= int(shift);
    else x = int(uint(x) << (32u - shift)) >> 16;
    int l = int(lo), h = int(hi);
    if (clmp) {
        if ((x >> 3) >= h) return (((h >> 2) - (l >> 2)) & 0x3FF) << 5;
        return max(x - (l << 3), 0);
    }
    return x - (l << 3);
}

int tex_mask(int c, uint mask, bool mirror) {
    if (mask == 0u) return c;
    int m = 1 << int(mask);
    if (mirror) c ^= max((c & m) - 1, 0);
    return c & (m - 1);
}

// raster::texel_at(): decoded table (raster::tex_cache_dims) when it covers the texel.
uint texel_at(uint sb, uint tb, int s, int t) {
    uint table = D[tb + 9u];
    if (table != GPU_NO_TABLE) {
        uint d = D[tb];
        uint ms = (d >> 12u) & 15u, mt = (d >> 16u) & 15u;
        uint ws = D[tb + 3u], wt = D[tb + 4u];
        uint w = ms != 0u ? (1u << ms) : ((((ws >> 16u) >> 2u) - ((ws & 0xFFFFu) >> 2u)) & 0x3FFu) + 2u;
        uint h = mt != 0u ? (1u << mt) : ((((wt >> 16u) >> 2u) - ((wt & 0xFFFFu) >> 2u)) & 0x3FFu) + 2u;
        if (uint(s) < w && uint(t) < h) return T[table + uint(t) * w + uint(s)];
    }
    return fetch_wrapped(tb, D[sb + 15u], D[sb + 1u] & 15u, s, t);
}

uint sample_texture(uint sb, uint tile_idx, float s, float t, bool second) {
    uint tb = sb + GPU_ST_TILES + (tile_idx & 7u) * GPU_TILE_WORDS;
    uint d = D[tb], sh = D[tb + 5u];
    int cs = tex_coord(s, sh & 0xFFu, ((d >> 20u) & 1u) != 0u, D[tb + 3u] & 0xFFFFu, D[tb + 3u] >> 16u);
    int ct = tex_coord(t, (sh >> 8u) & 0xFFu, ((d >> 21u) & 1u) != 0u, D[tb + 4u] & 0xFFFFu, D[tb + 4u] >> 16u);
    uint ms = (d >> 12u) & 15u, mt = (d >> 16u) & 15u;
    bool mirs = ((d >> 22u) & 1u) != 0u, mirt = ((d >> 23u) & 1u) != 0u;
    int is = cs >> 5, it = ct >> 5;
    int s0 = tex_mask(is, ms, mirs), t0r = tex_mask(it, mt, mirt);
    uint flags = D[sb];
    if ((flags & GPU_ST_POINT) != 0u) return texel_at(sb, tb, s0, t0r & 0xFF);
    int fs = cs & 31, ft = ct & 31;
    int s1 = tex_mask(is + 1, ms, mirs), t1r = tex_mask(it + 1, mt, mirt);
    int t0 = t0r & 0xFF, t1 = t0 + max(t1r - t0r, -255);
    bool bilerp = (flags & (second ? GPU_ST_BILERP1 : GPU_ST_BILERP0)) != 0u;
    bool upper = fs + ft >= 32;
    if (!bilerp) return upper ? texel_at(sb, tb, s1, t1) : texel_at(sb, tb, s0, t0);
    uint c10 = texel_at(sb, tb, s1, t0);
    uint c01 = texel_at(sb, tb, s0, t1);
    uint o = 0u;
    if ((flags & GPU_ST_MID_TEXEL) != 0u && fs == 16 && ft == 16) {
        uint c00 = texel_at(sb, tb, s0, t0), c11 = texel_at(sb, tb, s1, t1);
        for (uint b = 0u; b < 32u; b += 8u) {
            uint sum = ((c00 >> b) & 0xFFu) + ((c10 >> b) & 0xFFu) + ((c01 >> b) & 0xFFu) + ((c11 >> b) & 0xFFu);
            o |= ((sum + 2u) >> 2u) << b;
        }
        return o;
    }
    uint base = upper ? texel_at(sb, tb, s1, t1) : texel_at(sb, tb, s0, t0);
    int f0 = upper ? 32 - ft : fs, f1 = upper ? 32 - fs : ft;
    for (uint b = 0u; b < 32u; b += 8u) {
        int bv = int((base >> b) & 0xFFu);
        int v = (((int((c10 >> b) & 0xFFu) - bv) * f0 + (int((c01 >> b) & 0xFFu) - bv) * f1 + 0x10) >> 5) + bv;
        o |= uint(v & 0xFF) << b;
    }
    return o;
}

// ---- Level of detail (raster::lod_tiles) ----------------------------------------

void lod_tiles(uint sb, float delta, uint prim_tile, out uint t0, out uint t1, out int lf) {
    uint lw = D[sb + GPU_ST_LOD];
    bool sharpen = (lw & GPU_LOD_SHARPEN) != 0u, detail = (lw & GPU_LOD_DETAIL) != 0u;
    uint max_level = (lw >> 8u) & 0xFFu;
    int min_level = int((lw >> 16u) & 0xFFu);
    int lod = delta >= 512.0 ? 0x4000 : int(delta * 32.0);
    bool magnify, distant;
    uint l_tile = 0u;
    if ((lod & 0x4000) != 0) {
        magnify = false;
        distant = true;
        lf = 0xFF;
    } else if (lod < 32 || lod < min_level) {
        magnify = true;
        distant = max_level == 0u;
        if (!sharpen && !detail) {
            lf = distant ? 0xFF : 0;
        } else {
            lf = (lod < min_level ? min_level : lod) << 3;
            if (sharpen) lf |= 0x100;
        }
    } else {
        magnify = false;
        uint texels = uint(lod >> 5) & 0xFFu;
        l_tile = texels != 0u ? uint(findMSB(texels)) : 0u;
        distant = max_level == 0u || (lod & 0x6000) != 0 || l_tile >= max_level;
        lf = (!sharpen && !detail && distant) ? 0xFF : ((lod << 3) >> l_tile) & 0xFF;
    }
    if ((lw & GPU_LOD_TEX_EN) == 0u) {
        t0 = prim_tile & 7u;
        t1 = (prim_tile + 1u) & 7u;
        return;
    }
    if (distant) l_tile = max_level;
    if (!detail) {
        t0 = (prim_tile + l_tile) & 7u;
        t1 = (distant || (!sharpen && magnify)) ? t0 : ((t0 + 1u) & 7u);
    } else {
        t0 = (prim_tile + l_tile + (magnify ? 0u : 1u)) & 7u;
        t1 = (prim_tile + l_tile + ((!distant && !magnify) ? 2u : 1u)) & 7u;
    }
}

// ---- Colour combiner (raster::combine) -------------------------------------------

int sext9(int v) { return int(uint(v) << 23u) >> 23; }
int cc_expand(int v) { return sext9(v - 0x80) + 0x80; }
int cc_equation(int a, int b, int c, int d) {
    int p = int(uint(cc_expand(a) - cc_expand(b)) * uint(sext9(c)) + 0x80u);
    return (p >> 8) + cc_expand(d);
}
int cc_clamp(int v) { return clamp(sext9(v - 0x80) + 0x80, 0, 0xFF); }

// raster::pixel_noise()
uint pixel_noise(uint sb, uint x, uint y) {
    uint h = (x * 0x9E3779B1u) ^ ((y + D[sb + GPU_ST_NOISE_SEED]) * 0x85EBCA77u);
    h ^= h >> 15u;
    h *= 0x2C1B3C6Du;
    h ^= h >> 12u;
    return h;
}

struct CombIn {
    ivec4 comb, t0, t1, shade;
    int noise, lod;
};

ivec4 argb_to_rgba(uint c) { return ivec4(int((c >> 16u) & 0xFFu), int((c >> 8u) & 0xFFu), int(c & 0xFFu), int(c >> 24u)); }

// Row `idx` (raster::CcIn) of the combiner's inputs, channel ch (r, g, b, a).
int cc_in(uint sb, uint idx, uint ch, CombIn ci) {
    switch (idx) {
        case 0u: return ci.comb[ch];
        case 1u: return ci.t0[ch];
        case 2u: return ci.t1[ch];
        case 3u: return int((D[sb + 6u] >> (24u - 8u * ch)) & 0xFFu);
        case 4u: return ci.shade[ch];
        case 5u: return int((D[sb + 7u] >> (24u - 8u * ch)) & 0xFFu);
        case 6u: return 0x100;
        case 7u: return ci.noise;
        case 9u: return ch < 3u ? int((D[sb + GPU_ST_KEY_CENTER] >> (8u * ch)) & 0xFFu) : 0;
        case 10u: return int(D[sb + GPU_ST_K45] & 0x1FFu);
        case 11u: return ch < 3u ? int((D[sb + GPU_ST_KEY_SCALE] >> (8u * ch)) & 0xFFu) : 0;
        case 12u: return ci.comb.a;
        case 13u: return ci.t0.a;
        case 14u: return ci.t1.a;
        case 15u: return int(D[sb + 6u] & 0xFFu);
        case 16u: return ci.shade.a;
        case 17u: return int(D[sb + 7u] & 0xFFu);
        case 18u: return ci.lod;
        case 19u: return int(D[sb + GPU_ST_LOD] >> 24u);
        case 20u: return int((D[sb + GPU_ST_K45] >> 16u) & 0x1FFu);
        default: return 0;
    }
}

ivec4 cc_cycle(uint sb, uint c, CombIn ci) {
    uint rgb = D[sb + 2u + 2u * c], al = D[sb + 3u + 2u * c];
    ivec4 o;
    for (uint ch = 0u; ch < 4u; ++ch) {
        uint w = ch < 3u ? rgb : al;
        o[ch] = cc_equation(cc_in(sb, w & 0xFFu, ch, ci), cc_in(sb, (w >> 8u) & 0xFFu, ch, ci),
                            cc_in(sb, (w >> 16u) & 0xFFu, ch, ci), cc_in(sb, w >> 24u, ch, ci));
    }
    return o;
}

uint combine(uint sb, uint tex0, uint tex1, ivec4 shade, int lod_frac, int noise, inout int alpha0) {
    CombIn ci;
    ci.comb = ivec4(0);
    ci.t0 = argb_to_rgba(tex0);
    ci.t1 = argb_to_rgba(tex1);
    ci.shade = shade;
    ci.noise = noise;
    ci.lod = lod_frac;
    ivec4 o;
    if ((D[sb] & GPU_ST_TWO_CYCLE) != 0u) {
        ivec4 c0 = cc_cycle(sb, 0u, ci);
        alpha0 = cc_clamp(c0.a);
        // The second cycle sees the texels swapped.
        ivec4 t = ci.t0;
        ci.t0 = ci.t1;
        ci.t1 = t;
        ci.comb = c0;
        o = cc_cycle(sb, 1u, ci);
    } else {
        o = cc_cycle(sb, 1u, ci);
    }
    return (uint(cc_clamp(o.a)) << 24u) | (uint(cc_clamp(o.r)) << 16u) | (uint(cc_clamp(o.g)) << 8u) | uint(cc_clamp(o.b));
}

// ---- Depth (raster::z_decompress and friends) --------------------------------------

int z_decompress(int z) {
    int exponent = z >> 11, mantissa = z & 0x7FF;
    int shift = max(6 - exponent, 0);
    int base = 0x40000 - (0x40000 >> exponent);
    return (mantissa << shift) + base;
}
int z_compress(int z) {
    int inv_z = max(0x3FFFF - z, 1);
    int exponent = clamp(17 - findMSB(inv_z), 0, 7);
    int shift = max(6 - exponent, 0);
    int mantissa = (z >> shift) & 0x7FF;
    return (exponent << 11) + mantissa;
}
int dz_compress(int dz) { return max(findMSB(dz), 0); }
int combine_dz(int dz) { return dz != 0 ? 1 << findMSB(dz) : 0; }
int dz_compress_prim(int dz) {
    int val = 0;
    if ((dz & 0xFF00) != 0) val |= 8;
    if ((dz & 0xF0F0) != 0) val |= 4;
    if ((dz & 0xCCCC) != 0) val |= 2;
    if ((dz & 0xAAAA) != 0) val |= 1;
    return val;
}
// raster::depth18(): Vertex::sz as the RDP's 18-bit depth.
int depth18(float sz) {
    float v = sz * (1023.0 * 32.0 * 8.0);
    return !(v > 0.0) ? 0 : v >= 262143.0 ? 0x3FFFF : int(v);
}

// ---- Memory stage (raster::pixel_backend, HiResSink::write) ----------------------

// The blender's divider (raster::blender_divider()), entry ((sum << 11) | n).
int bl_divide(int sum, int n) {
    int i = ((sum << 11) | n) & 0x7FFF;
    int d = (i >> 11) & 0xF, nn = i & 0x7FF, invd = ~d & 0xF;
    int res = 0;
    int partial = (invd + (nn >> 8) + 1) & 7;
    for (int k = 0; k < 8; ++k) {
        int nbit = (nn >> (7 - k)) & 1;
        int sm = (res & (0x100 >> k)) != 0 ? invd + (partial << 1) + nbit + 1 : d + (partial << 1) + nbit;
        partial = sm & 7;
        if ((sm & 0x10) != 0) res |= 1 << (7 - k);
    }
    return res;
}

struct Aux {
    uint shade_a, cvg, noise;
    int alpha0; // -1: none
    int z, dz, dzc;
};

Aux aux_default() {
    Aux a;
    a.shade_a = 255u;
    a.cvg = 8u;
    a.noise = 0u;
    a.alpha0 = -1;
    a.z = 0;
    a.dz = 1;
    a.dzc = 0;
    return a;
}

ivec3 blend_cycle(uint sb, uint mux, bool final_cycle, bool blend_en, bool overflow, ivec4 px, ivec4 memc, uint shade_a,
                  int shift_a, int shift_b) {
    uint p = mux & 3u, a = (mux >> 8u) & 3u, m = (mux >> 16u) & 3u, b = (mux >> 24u) & 3u;
    uint bc = D[sb + 8u], fc = D[sb + 9u];
    ivec4 blc = ivec4(int(bc >> 24u), int((bc >> 16u) & 0xFFu), int((bc >> 8u) & 0xFFu), int(bc & 0xFFu));
    ivec4 fog = ivec4(int(fc >> 24u), int((fc >> 16u) & 0xFFu), int((fc >> 8u) & 0xFFu), int(fc & 0xFFu));
    ivec4 src1 = m == 0u ? px : m == 1u ? memc : m == 2u ? blc : fog;
    if (final_cycle && (D[sb] & GPU_ST_COLOR_ON_CVG) != 0u && !overflow) return src1.rgb;
    ivec4 src0 = p == 0u ? px : p == 1u ? memc : p == 2u ? blc : fog;
    if (final_cycle && (!blend_en || (a == 0u && b == 0u && px.a == 0xFF))) return src0.rgb;
    int a0 = a == 0u ? px.a : a == 1u ? fog.a : a == 2u ? int(shade_a) : 0;
    int a1 = b == 0u ? (~a0 & 0xFF) : b == 1u ? memc.a : b == 2u ? 0xFF : 0;
    a0 >>= 3;
    a1 >>= 3;
    if (b == 1u) {
        a0 = (a0 >> shift_a) & 0x3C;
        a1 = (a1 >> shift_b) | 3;
    }
    ivec3 v = src0.rgb * a0 + src1.rgb * (a1 + 1);
    if (!final_cycle || (D[sb] & GPU_ST_FORCE_BLEND) != 0u) return (v >> 5) & 0xFF;
    int sum = (a0 >> 2) + (a1 >> 2) + 1;
    return ivec3(bl_divide(sum, (v.r >> 2) & 0x7FF), bl_divide(sum, (v.g >> 2) & 0x7FF), bl_divide(sum, (v.b >> 2) & 0x7FF));
}

// The colour keeps the pixel's coverage in the upper 3 bits of alpha; the
// depth, what the RDP keeps in RDRAM (halfword << 2 | ninth bits), as a
// float (1e30: cleared).
void sink_write(uint sb, uint x, uint y, uint src, Aux aux, inout uint c, inout float zbuf) {
    if (x < D[sb + 11u] || x >= D[sb + 12u] || y < D[sb + 13u] || y >= D[sb + 14u]) return;
    uint flags = D[sb];
    int in_a = int(src >> 24u);
    if ((flags & GPU_ST_COPY) != 0u) {
        if ((flags & GPU_ST_ALPHA_TEST) != 0u && in_a == 0) return;
        c = (in_a != 0 ? 0xE0000000u : 0u) | (src & 0x00FFFFFFu);
        return;
    }
    int cvg = int(aux.cvg);
    int expanded = in_a + ((in_a + 1) >> 8);
    int modulated;
    if ((flags & GPU_ST_CVG_X_ALPHA) != 0u) {
        modulated = (expanded * cvg + 4) >> 3;
        cvg = modulated >> 5;
    } else {
        modulated = cvg << 5;
    }
    bool cvg_sel = (flags & GPU_ST_ALPHA_CVG_SEL) != 0u;
    int alpha = clamp(cvg_sel ? modulated : expanded, 0, 0xFF);
    if ((flags & GPU_ST_AA) != 0u && cvg == 0) return;
    uint w1 = D[sb + 1u];
    if ((flags & GPU_ST_ALPHA_TEST) != 0u) {
        int ref = alpha;
        if ((flags & GPU_ST_TWO_CYCLE) != 0u && aux.alpha0 >= 0) {
            int ea = aux.alpha0 + ((aux.alpha0 + 1) >> 8);
            if (cvg_sel) ea = (flags & GPU_ST_CVG_X_ALPHA) != 0u ? (ea * int(aux.cvg) + 4) >> 3 : int(aux.cvg) << 5;
            ref = clamp(ea, 0, 0xFF);
        }
        int threshold = (flags & GPU_ST_ALPHA_DITHER) != 0u ? int(aux.noise) : int((w1 >> 16u) & 0xFFu);
        if (ref < threshold) return;
    }

    int mem_cvg = (flags & GPU_ST_IMAGE_READ) != 0u ? int(c >> 29u) : 7;
    bool overflow = cvg + mem_cvg >= 8;
    bool blend_en;
    bool force = (flags & GPU_ST_FORCE_BLEND) != 0u, aa = (flags & GPU_ST_AA) != 0u;
    int z = aux.z;
    int shift_a = 0, shift_b = 0;
    if ((flags & GPU_ST_Z_COMPARE) != 0u) {
        int zv = zbuf < 1e29 ? int(zbuf) : (0xFFFC << 2);
        int cur_depth = zv >> 4;
        int cur_dz = zv & 15;
        int memory_z = z_decompress(cur_depth);
        int memory_dz = 1 << cur_dz;
        int prec = (cur_depth >> 11) & 0xF;
        bool coplanar = false;
        shift_a = clamp(aux.dzc - cur_dz, 0, 4);
        shift_b = clamp(cur_dz - aux.dzc, 0, 4);
        if (prec < 3) {
            if (memory_dz != 0x8000) {
                memory_dz = max(memory_dz << 1, 16 >> prec);
            } else {
                coplanar = true;
                memory_dz = 0xFFFF;
            }
        }
        int combined_dz = combine_dz(aux.dz | memory_dz);
        int combined_dz_ip = combined_dz;
        combined_dz <<= 3;
        bool farther = coplanar || (z + combined_dz) >= memory_z;
        blend_en = force || (!overflow && aa && farther);
        bool max_z = memory_z == 0x3FFFF;
        bool front = z < memory_z;
        bool nearer = coplanar || (z - combined_dz) <= memory_z;
        uint zmode = (w1 >> 8u) & 3u;
        bool pass;
        if (zmode == 0u) {
            pass = max_z || (overflow ? front : nearer);
        } else if (zmode == 1u) {
            if (!front || !farther || !overflow) {
                pass = max_z || (overflow ? front : nearer);
            } else {
                int cdz = dz_compress(combined_dz_ip & 0xFFFF);
                int coeff = ((memory_z >> cdz) - (z >> cdz)) & 0xF;
                cvg = min((coeff * cvg) >> 3, 8);
                pass = true;
            }
        } else if (zmode == 2u) {
            pass = front || max_z;
        } else {
            pass = farther && nearer && !max_z;
        }
        if (!pass || (aa && cvg == 0)) return;
    } else {
        shift_b = min(0xF - aux.dzc, 4);
        blend_en = force || (!overflow && aa);
    }

    ivec4 px = ivec4(int((src >> 16u) & 0xFFu), int((src >> 8u) & 0xFFu), int(src & 0xFFu), alpha);
    uint mm = (flags & GPU_ST_16BIT) != 0u ? 0xF8u : 0xFFu;
    ivec4 memc = ivec4(int((c >> 16u) & mm), int((c >> 8u) & mm), int(c & mm), mem_cvg << 5);
    ivec3 rgb;
    if ((flags & GPU_ST_TWO_CYCLE) != 0u) {
        rgb = blend_cycle(sb, D[sb + 10u], false, blend_en, overflow, px, memc, aux.shade_a, shift_a, shift_b);
        px.rgb = rgb;
        rgb = blend_cycle(sb, D[sb + GPU_ST_BLEND2], true, blend_en, overflow, px, memc, aux.shade_a, shift_a, shift_b);
    } else {
        rgb = blend_cycle(sb, D[sb + 10u], true, blend_en, overflow, px, memc, aux.shade_a, shift_a, shift_b);
    }
    int ncvg;
    uint cmode = (w1 >> 10u) & 3u;
    if (cmode == 0u) ncvg = blend_en ? min(7, mem_cvg + cvg) : (cvg - 1) & 7;
    else if (cmode == 1u) ncvg = (cvg + mem_cvg) & 7;
    else if (cmode == 2u) ncvg = 7;
    else ncvg = mem_cvg;
    c = (uint(ncvg) << 29u) | (uint(rgb.r) << 16u) | (uint(rgb.g) << 8u) | uint(rgb.b);
    if ((flags & GPU_ST_Z_UPDATE) != 0u) zbuf = float((z_compress(z) << 4) | aux.dzc);
}

// ---- Primitives -------------------------------------------------------------------

// Coverage as raster::triangle() works it out: 8 samples per pixel, a sample
// on an edge belonging to the triangle on its right (or below a horizontal
// one); attributes at the first covered sample.
const float kSampleX[8] = float[8](0.0, 0.5, 0.25, 0.75, 0.0, 0.5, 0.25, 0.75);
const float kSampleY[8] = float[8](0.0, 0.0, 0.25, 0.25, 0.5, 0.5, 0.75, 0.75);
bool edge_tie(float a, float b, float sgn) { return a * sgn > 0.0 || (a == 0.0 && b * sgn > 0.0); }
bool edge_in(float e, bool t) { return e > 0.0 || (e == 0.0 && t); }

void draw_triangle(uint pb, uint sb, uint x, uint y, inout uint c, inout float z) {
    float px = float(x) * P.inv_scale;
    float py = float(y) * P.inv_scale;
    float x0 = fword(pb + 3u), y0 = fword(pb + 4u);
    float x1 = fword(pb + 10u), y1 = fword(pb + 11u);
    float x2 = fword(pb + 17u), y2 = fword(pb + 18u);
    float inv_area = fword(pb + 24u);
    float area = 1.0 / inv_area;
    float sgn = inv_area > 0.0 ? 1.0 : -1.0;
    vec3 ea = vec3(y1 - y2, y2 - y0, y0 - y1);
    vec3 eb = vec3(x2 - x1, x0 - x2, x1 - x0);
    bvec3 ties = bvec3(edge_tie(ea.x, eb.x, sgn), edge_tie(ea.y, eb.y, sgn), edge_tie(ea.z, eb.z, sgn));
    vec3 e;
    e.x = ((x1 - px) * (y2 - py) - (x2 - px) * (y1 - py)) * sgn;
    e.y = ((x2 - px) * (y0 - py) - (x0 - px) * (y2 - py)) * sgn;
    e.z = area * sgn - e.x - e.y;
    uint mask = 0u;
    for (int i = 0; i < 8; ++i) {
        vec3 d = (ea * kSampleX[i] + eb * kSampleY[i]) * P.inv_scale * sgn;
        vec3 es = e + d;
        if (edge_in(es.x, ties.x) && edge_in(es.y, ties.y) && edge_in(es.z, ties.z)) mask |= 1u << uint(i);
    }
    uint flags = D[sb];
    if ((flags & GPU_ST_AA) != 0u ? mask == 0u : (mask & 1u) == 0u) return;
    // Texture coordinates at the corner, shade and depth at the first covered sample.
    float tw0 = e.x * sgn * inv_area;
    float tw1 = e.y * sgn * inv_area;
    float tw2 = 1.0 - tw0 - tw1;
    int first = findLSB(mask);
    if (first != 0) e += (ea * kSampleX[first] + eb * kSampleY[first]) * P.inv_scale * sgn;
    float w0 = e.x * sgn * inv_area;
    float w1 = e.y * sgn * inv_area;
    float w2 = 1.0 - w0 - w1;

    Aux aux = aux_default();
    aux.cvg = uint(bitCount(mask));
    uint pz = D[sb + GPU_ST_PRIM_Z];
    aux.z = (flags & GPU_ST_Z_PRIM) != 0u ? int(pz & 0x7FFFu) << 3
                                          : depth18(w0 * fword(pb + 5u) + w1 * fword(pb + 12u) + w2 * fword(pb + 19u));
    aux.dz = int(D[pb + 26u] & 0xFFFFu);
    aux.dzc = int(D[pb + 26u] >> 16u);
    uint c0 = D[pb + 9u], c1 = D[pb + 16u], c2 = D[pb + 23u];
    ivec4 shade;
    if ((flags & GPU_ST_SMOOTH) != 0u) {
        for (uint ch = 0u; ch < 4u; ++ch) {
            uint sh = ch * 8u;
            float v = w0 * float((c0 >> sh) & 0xFFu) + w1 * float((c1 >> sh) & 0xFFu) + w2 * float((c2 >> sh) & 0xFFu);
            shade[ch] = int(clamp(v, 0.0, 255.0));
        }
    } else {
        shade = ivec4(int(c0 & 0xFFu), int((c0 >> 8u) & 0xFFu), int((c0 >> 16u) & 0xFFu), int(c0 >> 24u));
    }
    aux.shade_a = uint(shade.a);
    int noise = (flags & GPU_ST_NOISE) != 0u ? int(((pixel_noise(sb, x, y) & 7u) << 6u) | 0x20u) : 0;

    uint color;
    if ((flags & GPU_ST_TEXTURED) != 0u) {
        float iw = tw0 * fword(pb + 6u) + tw1 * fword(pb + 13u) + tw2 * fword(pb + 20u);
        float w_interp = iw != 0.0 ? 1.0 / iw : 1.0;
        float uw = tw0 * fword(pb + 7u) + tw1 * fword(pb + 14u) + tw2 * fword(pb + 21u);
        float vw = tw0 * fword(pb + 8u) + tw1 * fword(pb + 15u) + tw2 * fword(pb + 22u);
        float u = uw * w_interp;
        float v = vw * w_interp;
        uint tile0 = (D[sb + 1u] >> 4u) & 7u;
        uint tile1 = (tile0 + 1u) & 7u;
        int lod_frac = 0;
        // How the barycentric weights change one frame buffer pixel right and down.
        float dw0x = (y1 - y2) * inv_area, dw1x = (y2 - y0) * inv_area, dw2x = -dw0x - dw1x;
        float iw0 = fword(pb + 6u), iw1 = fword(pb + 13u), iw2 = fword(pb + 20u);
        float u0 = fword(pb + 7u), u1 = fword(pb + 14u), u2 = fword(pb + 21u);
        float v0 = fword(pb + 8u), v1 = fword(pb + 15u), v2 = fword(pb + 22u);
        float diw_dx = dw0x * iw0 + dw1x * iw1 + dw2x * iw2;
        float duw_dx = dw0x * u0 + dw1x * u1 + dw2x * u2, dvw_dx = dw0x * v0 + dw1x * v1 + dw2x * v2;
        if ((D[sb + GPU_ST_LOD] & GPU_LOD_DOLOD) != 0u) {
            float dw0y = (x2 - x1) * inv_area, dw1y = (x0 - x2) * inv_area, dw2y = -dw0y - dw1y;
            float iwx = iw + diw_dx, iwy = iw + (dw0y * iw0 + dw1y * iw1 + dw2y * iw2);
            float rx = iwx != 0.0 ? 1.0 / iwx : 1.0, ry = iwy != 0.0 ? 1.0 / iwy : 1.0;
            float delta = max(max(abs((uw + duw_dx) * rx - u), abs((vw + dvw_dx) * rx - v)),
                              max(abs((uw + (dw0y * u0 + dw1y * u1 + dw2y * u2)) * ry - u),
                                  abs((vw + (dw0y * v0 + dw1y * v1 + dw2y * v2)) * ry - v)));
            lod_tiles(sb, delta, tile0, tile0, tile1, lod_frac);
        }
        if ((flags & GPU_ST_COMBINED) != 0u) {
            uint tex = (flags & GPU_ST_NEED_TEX0) != 0u ? sample_texture(sb, tile0, u, v, false) : 0u;
            uint tex1 = 0u;
            if ((flags & GPU_ST_NEED_TEX1) != 0u) {
                tex1 = sample_texture(sb, tile1, u, v, true);
            } else if ((flags & GPU_ST_PIPE_TEX1) != 0u) {
                // The next pixel the RDP walks.
                float step = fword(pb + 25u) * P.inv_scale;
                float iwn = iw + diw_dx * step;
                float rn = iwn != 0.0 ? 1.0 / iwn : 1.0;
                tex1 = sample_texture(sb, tile0, (uw + duw_dx * step) * rn, (vw + dvw_dx * step) * rn, false);
            }
            color = combine(sb, tex, tex1, shade, lod_frac, noise, aux.alpha0);
            if ((flags & GPU_ST_TWO_CYCLE) == 0u) aux.alpha0 = -1;
        } else {
            // Texture modulated by the vertex colour.
            uint tex = sample_texture(sb, tile0, u, v, false);
            uint r = uint(shade.r) * ((tex >> 16u) & 0xFFu) / 255u;
            uint g = uint(shade.g) * ((tex >> 8u) & 0xFFu) / 255u;
            uint b = uint(shade.b) * (tex & 0xFFu) / 255u;
            uint a = uint(shade.a) * (tex >> 24u) / 255u;
            color = (a << 24u) | (r << 16u) | (g << 8u) | b;
        }
    } else if ((flags & GPU_ST_COMBINED) != 0u) {
        color = combine(sb, 0u, 0u, shade, 0, noise, aux.alpha0);
        if ((flags & GPU_ST_TWO_CYCLE) == 0u) aux.alpha0 = -1;
    } else {
        color = (uint(shade.a) << 24u) | (uint(shade.r) << 16u) | (uint(shade.g) << 8u) | uint(shade.b);
    }
    if ((flags & GPU_ST_ALPHA_DITHER) != 0u) aux.noise = (pixel_noise(sb, x, y) >> 8u) & 0xFFu;
    sink_write(sb, x, y, color, aux, c, z);
}

void draw_rect(uint pb, uint sb, uint x, uint y, inout uint c, inout float z) {
    // Outside the scissor: dropped by sink_write anyway.
    if (x < D[sb + 11u] || x >= D[sb + 12u] || y < D[sb + 13u] || y >= D[sb + 14u]) return;
    uint flags = D[sb];
    uint fl = D[pb + 8u];
    bool flip = (fl & 1u) != 0u;
    float nx = float(x) * P.inv_scale, ny = float(y) * P.inv_scale;
    uint mask = 0xFFu;
    if ((fl & 2u) == 0u) {
        // Coverage: the 8 samples within the edges (quarter pixels).
        float ulx = float(D[pb + 14u] & 0xFFFFu), uly = float(D[pb + 14u] >> 16u);
        float lrx = float(D[pb + 15u] & 0xFFFFu), lry = float(D[pb + 15u] >> 16u);
        mask = 0u;
        for (int i = 0; i < 8; ++i) {
            float qx = nx * 4.0 + kSampleX[i] * 4.0 * P.inv_scale, qy = ny * 4.0 + kSampleY[i] * 4.0 * P.inv_scale;
            if (qx >= ulx && qx < lrx && qy >= uly && qy < lry) mask |= 1u << uint(i);
        }
        if ((flags & GPU_ST_AA) != 0u ? mask == 0u : (mask & 1u) == 0u) return;
    }
    float dx = fword(pb + 6u), dy = fword(pb + 7u);
    float ax = (nx - fword(pb + 16u)) * dx, ay = (ny - fword(pb + 17u)) * dy;
    if (P.scale > 1u) {
        ax = clamp(ax, fword(pb + 9u), fword(pb + 10u));
        ay = clamp(ay, fword(pb + 11u), fword(pb + 12u));
    }
    float ss = fword(pb + 4u) + (flip ? ay : ax);
    float st = fword(pb + 5u) + (flip ? ax : ay);
    uint lt = D[pb + 13u];
    uint t0 = lt & 15u, t1 = (lt >> 4u) & 15u;
    Aux aux = aux_default();
    aux.shade_a = 0u; // rectangles have no shade, nor depth (but the primitive's)
    aux.cvg = uint(bitCount(mask));
    if ((flags & GPU_ST_Z_PRIM) != 0u) {
        uint pz = D[sb + GPU_ST_PRIM_Z];
        aux.z = int(pz & 0x7FFFu) << 3;
        aux.dz = int(pz >> 16u);
    }
    aux.dzc = dz_compress_prim(aux.dz);
    uint color;
    if ((flags & GPU_ST_COMBINED) == 0u || (flags & GPU_ST_COPY) != 0u) {
        color = sample_texture(sb, t0, ss, st, false);
    } else {
        uint tex = (flags & GPU_ST_NEED_TEX0) != 0u ? sample_texture(sb, t0, ss, st, false) : 0u;
        uint tex1 = 0u;
        if ((flags & GPU_ST_NEED_TEX1) != 0u) {
            tex1 = sample_texture(sb, t1, ss, st, true);
        } else if ((flags & GPU_ST_PIPE_TEX1) != 0u) { // the next pixel's, rightwards
            float step = dx * P.inv_scale;
            tex1 = sample_texture(sb, t0, flip ? ss : ss + step, flip ? st + step : st, false);
        }
        int noise = (flags & GPU_ST_NOISE) != 0u ? int(((pixel_noise(sb, x, y) & 7u) << 6u) | 0x20u) : 0;
        color = combine(sb, tex, tex1, ivec4(0), int(lt >> 8u), noise, aux.alpha0);
        if ((flags & GPU_ST_TWO_CYCLE) == 0u) aux.alpha0 = -1;
    }
    if ((flags & GPU_ST_ALPHA_DITHER) != 0u) aux.noise = (pixel_noise(sb, x, y) >> 8u) & 0xFFu;
    sink_write(sb, x, y, color, aux, c, z);
}

void main() {
    uint S = P.scale;
    uint tile = D[P.work_list + gl_WorkGroupID.y];
    uint sub = gl_WorkGroupID.x;
    uint tx = tile % P.tiles_x, ty = tile / P.tiles_x;
    uint x = tx * GPU_BIN_SIZE * S + (sub % S) * 8u + gl_LocalInvocationID.x;
    uint y = ty * GPU_BIN_SIZE * S + (sub / S) * 8u + gl_LocalInvocationID.y;
    if (x >= P.width || y >= P.height) return;

    uint idx = y * P.width + x;
    uint c = color_buf[idx];
    bool depth = P.has_depth != 0u;
    float z = depth ? depth_buf[idx] : 0.0;
    float z_in = z;
    uint c_in = c;

    uint first = D[P.tile_table + tile * 2u];
    uint count = D[P.tile_table + tile * 2u + 1u];
    for (uint i = 0u; i < count; ++i) {
        uint pb = P.prims + D[first + i] * GPU_PRIM_WORDS;
        uint bx = D[pb + 1u], by = D[pb + 2u];
        uint px0 = bx & 0xFFFFu, py0 = by & 0xFFFFu;
        if (x < px0 || x > (bx >> 16u) || y < py0 || y > (by >> 16u)) continue;
        uint type = D[pb];
        uint sb = D[pb + GPU_PRIM_STATE];
        if (type == GPU_PRIM_TRI) {
            draw_triangle(pb, sb, x, y, c, z);
        } else if (type == GPU_PRIM_RECT) {
            draw_rect(pb, sb, x, y, c, z);
        } else if (type == GPU_PRIM_FILL) {
            c = D[pb + 3u];
        } else if (type == GPU_PRIM_BLOCK) {
            Aux a = aux_default();
            a.z = depth18(fword(pb + 4u));
            sink_write(sb, x, y, D[pb + 3u], a, c, z);
        } else if (type == GPU_PRIM_BLIT) {
            uint w = D[pb + 4u];
            uint src = D[pb + 3u] + (y / S - D[pb + 6u]) * w + (x - D[pb + 5u] * S) / S;
            sink_write(sb, x, y, D[src], aux_default(), c, z);
        } else if (type == GPU_PRIM_UPLOAD) {
            uint w = D[pb + 4u];
            uint e = D[pb + 3u] + ((y / S - D[pb + 6u]) * w + (x / S - D[pb + 5u])) * 2u;
            if (D[e] != 0u) c = D[e + 1u];
        }
    }
    if (c != c_in) color_buf[idx] = c;
    if (depth && z != z_in) depth_buf[idx] = z;
}
