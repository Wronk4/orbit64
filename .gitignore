# Build output
build/
bin/
out/
*.dll
*.exe

# ROMs, saves, and other emulator run artifacts (not source, often copyrighted).
# Put ROMs in roms/ - only its README is tracked.
roms/*
!roms/README.md
*.z64
*.n64
*.sav
*.ram
*.bmp
*.bin

# OS/editor cruft
.DS_Store
*.gch

# Backups
backup_before_*/

# Output of the test tools (tools/jit_bench.sh, --wav captures, reports, ...)
test_output/
# Profiling / checked builds (make BUILD_DIR=... BIN_DIR=...)
build_*/
bin_*/

# Local reference material, e.g. the Nintendo 64 SDK (proprietary, never committed)
reference/

# Python bytecode of the tools
__pycache__/
